{
  "title": "Yukh deterministic team execution plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workers", "synthesis"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "workers": {
      "type": "array",
      "items": { "$ref": "#/$defs/agent" }
    },
    "synthesis": { "$ref": "#/$defs/agent" }
  },
  "$defs": {
    "token": {
      "type": "string"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "role",
        "mission",
        "model",
        "skills",
        "instructions",
        "task",
        "context_paths",
        "tool_mode",
        "max_commands",
        "timeout_ms",
        "token_budget"
      ],
      "properties": {
        "runtime": { "type": "string", "enum": ["codex", "copilot"] },
        "role": {
          "type": "string",
          "description": "Lowercase role slug matching ^[a-z][a-z0-9-]{0,31}$; use hyphens, never spaces."
        },
        "mission": { "type": "string" },
        "model": { "$ref": "#/$defs/token" },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/token" }
        },
        "instructions": { "type": "string" },
        "task": { "type": "string" },
        "context_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "At most four repository-relative regular files; synthesis must use an empty list."
        },
        "tool_mode": {
          "type": "string",
          "enum": ["none", "coordination", "team"],
          "description": "Use none unless this agent explicitly needs Yukh communication or delegation."
        },
        "max_commands": {
          "type": "integer",
          "description": "Closed command-start limit from 0 through 32."
        },
        "timeout_ms": {
          "type": "integer",
          "description": "Closed wall-clock limit from 5000 through 900000 milliseconds."
        },
        "token_budget": { "type": "integer" }
      }
    }
  }
}
